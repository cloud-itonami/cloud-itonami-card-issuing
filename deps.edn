{:paths ["src" "resources"]
 ;; Dependencies are named by GIT COORDINATE, not :local/root.
 ;;
 ;; The previous deps.edn said this repo "is standalone (forkable outside the
 ;; workspace)" and then used :local/root anyway, telling a forker they "should
 ;; override them with git coordinates". That puts the burden on the forker and
 ;; means the repo as published could not build a classpath at all -- tools.deps
 ;; resolves "../../kotoba-lang/langgraph" relative to the FORK's directory. The
 ;; comment knew about the problem and resolved it the wrong way round. Same defect
 ;; and same fix as kotoba-lang/{card,phone,esim} and cloud-itonami-esim.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}

        ;; The records / lifecycle / ports / actuation contracts. This actor holds
        ;; no second copy of the lifecycle table: kotoba.card.lifecycle mirrors
        ;; THIS repo's governor/legal-predecessor and store/lifecycle!, and the
        ;; library's own tests transcribe them, so a divergence fails there.
        io.github.kotoba-lang/card
        {:git/url "https://github.com/kotoba-lang/card.git"
         :git/sha "62d9ea207a717e213177450d5538d8491fee8295"}

        ;; The live issuer. Implements kotoba.card.actuation (post-approval), NOT
        ;; kotoba.card.ports (propose-only). Carries no credential: the key is read
        ;; from a caller-named env var at call time.
        io.github.kotoba-lang/io-stripe-issuing
        {:git/url "https://github.com/kotoba-lang/io-stripe-issuing.git"
         :git/sha "02c33fe0aac6343684aef371139257071e841f7e"}

        ;; The HTTP surface's JSON codec. com.sun.net.httpserver is JDK-provided.
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:dev {:override-deps
        {io.github.com-junkawasaki/langgraph-clj {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/card {:local/root "../../kotoba-lang/card"}
         io.github.kotoba-lang/io-stripe-issuing {:local/root "../../kotoba-lang/io-stripe-issuing"}}}
  :run {:main-opts ["-m" "cardissuing.sim"]}
  ;; clojure -M:serve -> the governed HTTP surfaces a consent surface hands to
  :serve {:main-opts ["-m" "cardissuing.http"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
